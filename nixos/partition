#!/usr/bin/env bash
# Run from the NixOS minimal ISO as root. Wipes a disk, mounts it at /mnt and
# writes a small base config, ready for nixos-install.
# Usage: partition /dev/nvme0n1
set -euo pipefail

disk=${1:-}
mnt=${MNT:-/mnt}

if [[ -z $disk ]]; then
    echo "Usage: $0 <disk>   e.g. $0 /dev/nvme0n1" >&2
    lsblk -d -o NAME,SIZE,MODEL >&2 || true
    exit 1
fi

if [[ $(lsblk -dno TYPE "$disk" 2>/dev/null) != disk ]]; then
    echo "$disk is not a disk. Pick one from: lsblk -d" >&2
    exit 1
fi

lsblk "$disk"
read -r -p "⚠️  Erase EVERYTHING on $disk? Type yes: " answer
if [[ $answer != yes ]]; then
    echo "Aborted, nothing changed." >&2
    exit 1
fi

# 1 GB EFI boot partition, the rest for NixOS
parted -s "$disk" -- mklabel gpt mkpart boot fat32 1MB 1GB set 1 esp on mkpart nixos ext4 1GB 100%
udevadm settle
mkfs.fat -F 32 -n boot /dev/disk/by-partlabel/boot
mkfs.ext4 -F -L nixos /dev/disk/by-partlabel/nixos

mount /dev/disk/by-label/nixos "$mnt"
mkdir -p "$mnt/boot"
mount -o umask=077 /dev/disk/by-label/boot "$mnt/boot"

nixos-generate-config --root "$mnt"

# just enough to boot, log in as tom, get online and build the repo's flake
cat > "$mnt/etc/nixos/configuration.nix" << 'EOF'
{ pkgs, ... }:
{
  imports = [ ./hardware-configuration.nix ];
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  networking.networkmanager.enable = true;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  users.users.tom = {
    isNormalUser = true;
    extraGroups = [ "wheel" "networkmanager" ];
  };
  environment.systemPackages = [ pkgs.git ];
  system.stateVersion = "26.05";
}
EOF

echo "✅ $disk is ready. Next: nixos-install"
